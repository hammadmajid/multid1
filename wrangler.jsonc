{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multid1",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "d1_databases": [
    {
      "binding": "DB_USERS",
      "database_name": "multid1-users",
      "database_id": "a72e41cc-457e-4e27-b027-1c1a9f644806",
      "migrations_dir": "drizzle/users"
    },
    {
      "binding": "DB_CART",
      "database_name": "multid1-cart",
      "database_id": "11785329-806c-433c-8ea9-2622698d8aa2",
      "migrations_dir": "drizzle/cart"
    },
    {
      "binding": "DB_CATALOG",
      "database_name": "multid1-catalog",
      "database_id": "e832d57c-13f5-4669-ad6e-8227b655bdb4",
      "migrations_dir": "drizzle/catalog"
    },
    {
      "binding": "DB_ORDERS",
      "database_name": "multid1-orders",
      "database_id": "d61329a3-e964-48ac-baa7-080fdda19294",
      "migrations_dir": "drizzle/orders"
    },
    {
      "binding": "DB_REVIEWS",
      "database_name": "multid1-reviews",
      "database_id": "f3de0be9-70a3-46f4-9185-9ae0116933ef",
      "migrations_dir": "drizzle/reviews"
    }
  ]
}

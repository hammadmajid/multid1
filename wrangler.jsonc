{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multid1",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "d1_databases": [
    {
      "binding": "DB_USERS",
      "database_name": "multid1-users",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "DB_CART",
      "database_name": "multid1-cart",
      "database_id": "00000000-0000-0000-0000-000000000002"
    },
    {
      "binding": "DB_CATALOG",
      "database_name": "multid1-catalog",
      "database_id": "00000000-0000-0000-0000-000000000003"
    },
    {
      "binding": "DB_ORDERS",
      "database_name": "multid1-orders",
      "database_id": "00000000-0000-0000-0000-000000000004"
    },
    {
      "binding": "DB_REVIEWS",
      "database_name": "multid1-reviews",
      "database_id": "00000000-0000-0000-0000-000000000005"
    }
  ]
}
